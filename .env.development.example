# Ambiente LOCAL de desenvolvimento. Copie para .env (que não vai para o GitHub):
#   copy .env.development.example .env      (Windows)
#   cp .env.development.example .env        (Linux/macOS)

# Banco do docker-compose.dev.yml (só no seu computador)
DATABASE_URL=postgres://postgres:dev-local@localhost:5433/app_compras

# Senha de todos os usuários de teste criados por npm run dev:setup / dev:restore
DEV_PASSWORD=troque-esta-senha-local

# Fotos e notas gravadas nesta pasta em vez do S3 (fica fora do GitHub)
LOCAL_STORAGE_DIR=.local-storage

# Endereço do computador na rede de casa, para abrir no celular (veja o guia).
# Ex.: DEV_LAN_HOSTS=192.168.0.15
DEV_LAN_HOSTS=
